# Shared
APP_ENV=development

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Backend
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=/app/uploads
RENDER_DIR=/app/rendered
MAX_UPLOAD_MB=1024
MOCK_PROVIDER_LATENCY_SECONDS=1

# PostgreSQL
POSTGRES_USER=cinesync
POSTGRES_PASSWORD=cinesync
POSTGRES_DB=cinesync
DATABASE_URL=postgresql+psycopg://cinesync:cinesync@postgres:5432/cinesync

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
